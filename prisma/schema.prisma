generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Location {
  id            Int                @id @default(autoincrement())
  name          String
  type          LocationType
  parentId      Int?
  password      String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  broadcasts    Broadcast[]
  targets       CampaignTarget[]
  communities   Community[]
  requests      EmergencyRequest[]
  events        Event[]
  parent        Location?          @relation("LocationHierarchy", fields: [parentId], references: [id])
  children      Location[]         @relation("LocationHierarchy")
  members       Member[]
  notifications Notification[]
  polls         Poll[]
  posts         Post[]
  users         User[]

  @@index([parentId])
  @@index([type])
}

model Member {
  id                   Int                    @id @default(autoincrement())
  name                 String
  surname              String?
  phone                String                 @unique
  password             String?
  image                String?
  dateOfBirth          String?
  gender               String?
  bloodGroup           String?
  allergies            String?
  conditions           String?
  emergencyContact     String?
  role                 String                 @default("Member")
  professionId         Int?
  locationId           Int
  approvalStatus       ApprovalStatus         @default(PENDING)
  consent              Boolean                @default(true)
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  createdById          Int?
  approvedById         Int?
  fcmToken             String?
  district             String?
  constituency         String?
  area                 String?
  street               String?
  communityMembers     CommunityMember[]
  communityPosts       CommunityPost[]
  communityPostLikes   CommunityPostLike[]
  communityPostReports CommunityPostReport[]
  payments             ContributionPayment[]
  contributionProfile  ContributionProfile?
  deletedNotifications DeletedNotification[]  @relation("MemberDeletedNotifications")
  requests             EmergencyRequest[]
  emergencyResponses   EmergencyResponse[]
  eventResponses       EventResponse[]
  approvedBy           User?                  @relation("MemberApprover", fields: [approvedById], references: [id])
  createdBy            User?                  @relation("MemberCreator", fields: [createdById], references: [id])
  location             Location               @relation(fields: [locationId], references: [id])
  profession           Profession?            @relation(fields: [professionId], references: [id])
  enrollments          MemberPlanEnrollment[]
  messageLogs          MessageLog[]
  polls                Poll[]
  pollLikes            PollLike[]
  pollReports          PollReport[]
  pollVotes            PollVote[]
  postLikes            PostLike[]
  postReports          PostReport[]
  warnings             UserWarning[]          @relation("MemberWarnings")
  commentLikes         CommentLike[]
  pollCommentLikes     PollCommentLike[]

  @@index([locationId])
  @@index([professionId])
}

model Profession {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   Member[]
}

model User {
  id                   Int                   @id @default(autoincrement())
  name                 String
  surname              String?
  phone                String                @unique
  password             String
  role                 UserRole              @default(MEMBER)
  approvalStatus       ApprovalStatus        @default(PENDING)
  locationId           Int?
  parentId             Int?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  fcmToken             String?
  image                String?
  dateOfBirth          String?
  gender               String?
  bloodGroup           String?
  profession           String?
  district             String?
  constituency         String?
  area                 String?
  street               String?
  auditLogs            AuditLog[]
  broadcasts           Broadcast[]
  campaigns            Campaign[]
  communityPosts       CommunityPost[]
  deletedNotifications DeletedNotification[] @relation("UserDeletedNotifications")
  createdRequests      EmergencyRequest[]
  createdEvents        Event[]
  approvedMembers      Member[]              @relation("MemberApprover")
  createdMembers       Member[]              @relation("MemberCreator")
  notifications        Notification[]
  polls                Poll[]
  location             Location?             @relation(fields: [locationId], references: [id])
  parent               User?                 @relation("Hierarchy", fields: [parentId], references: [id])
  children             User[]                @relation("Hierarchy")
  warningsCreated      UserWarning[]         @relation("AdminWarnings")

  @@index([role])
  @@index([approvalStatus])
}

model Campaign {
  id          Int              @id @default(autoincrement())
  title       String
  message     String
  createdById Int
  status      CampaignStatus   @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   User             @relation(fields: [createdById], references: [id])
  targets     CampaignTarget[]
  messageLogs MessageLog[]
}

model CampaignTarget {
  id         Int      @id @default(autoincrement())
  campaignId Int
  locationId Int
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  location   Location @relation(fields: [locationId], references: [id])
}

model MessageLog {
  id                Int           @id @default(autoincrement())
  campaignId        Int
  memberId          Int
  phone             String
  status            MessageStatus @default(PENDING)
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime      @default(now())
  campaign          Campaign      @relation(fields: [campaignId], references: [id])
  member            Member        @relation(fields: [memberId], references: [id])
}

model OTP {
  id         Int      @id @default(autoincrement())
  phone      String
  otp        String
  expiresAt  DateTime
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([phone])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  details   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Event {
  id          Int             @id @default(autoincrement())
  title       String
  description String?
  date        DateTime
  locationId  Int
  status      EventStatus     @default(ACTIVE)
  createdById Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   User            @relation(fields: [createdById], references: [id])
  location    Location        @relation(fields: [locationId], references: [id])
  responses   EventResponse[]
}

model EventResponse {
  id        Int        @id @default(autoincrement())
  eventId   Int
  memberId  Int
  status    RSVPStatus
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  event     Event      @relation(fields: [eventId], references: [id])
  member    Member     @relation(fields: [memberId], references: [id])

  @@unique([eventId, memberId])
}

model EmergencyRequest {
  id               Int                 @id @default(autoincrement())
  title            String
  description      String?
  type             String              @default("EMERGENCY")
  status           RequestStatus       @default(PENDING)
  locationId       Int
  memberId         Int?
  createdById      Int?
  audience         String?
  contactName      String?
  contactPhone     String?
  expiryDate       DateTime?
  collectResponse  Boolean             @default(true)
  bloodGroup       String?
  unitsRequired    String?
  hospitalName     String?
  patientCondition String?
  disasterType     String?
  affectedArea     String?
  requiredSupport  String?
  volunteerType    String?
  forwardedBy      String?
  forwardedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  createdBy        User?               @relation(fields: [createdById], references: [id])
  location         Location            @relation(fields: [locationId], references: [id])
  member           Member?             @relation(fields: [memberId], references: [id])
  responses        EmergencyResponse[]
}

model EmergencyResponse {
  id                 Int              @id @default(autoincrement())
  emergencyRequestId Int
  memberId           Int
  status             RSVPStatus
  note               String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  emergencyRequest   EmergencyRequest @relation(fields: [emergencyRequestId], references: [id], onDelete: Cascade)
  member             Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([emergencyRequestId, memberId])
}

model Post {
  id            Int          @id @default(autoincrement())
  content       String
  category      String?      @default("Discussion")
  images        String[]
  authorName    String
  authorRole    String?
  likes         Int          @default(0)
  locationId    Int
  createdAt     DateTime     @default(now())
  createdById   Int?
  createdByType String?
  status        String       @default("ACTIVE")
  comments      Comment[]
  location      Location     @relation(fields: [locationId], references: [id])
  likesList     PostLike[]
  reports       PostReport[]
}

model Poll {
  id          Int           @id @default(autoincrement())
  question    String
  locationId  Int
  communityId Int?
  memberId    Int?
  createdById Int?
  expiresAt   DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  community   Community?    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy   User?         @relation(fields: [createdById], references: [id])
  location    Location      @relation(fields: [locationId], references: [id])
  member      Member?       @relation(fields: [memberId], references: [id])
  comments    PollComment[]
  likesList   PollLike[]
  options     PollOption[]
  reports     PollReport[]
  votes       PollVote[]

  @@index([locationId])
  @@index([communityId])
}

model PollOption {
  id     Int        @id @default(autoincrement())
  pollId Int
  text   String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]
}

model PollVote {
  id        Int        @id @default(autoincrement())
  pollId    Int
  optionId  Int
  memberId  Int
  createdAt DateTime   @default(now())
  member    Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, memberId])
}

model Comment {
  id         Int           @id @default(autoincrement())
  content    String
  authorName String
  authorRole String?
  postId     Int
  parentId   Int?
  createdAt  DateTime      @default(now())
  post       Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent     Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]     @relation("CommentReplies")
  likesList  CommentLike[]
}

model CommentLike {
  id        Int      @id @default(autoincrement())
  commentId Int
  memberId  Int
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([commentId, memberId])
}

model Notification {
  id          Int                   @id @default(autoincrement())
  title       String
  message     String
  type        String
  time        String?
  purpose     String?
  entityType  String?
  entityId    Int?
  status      String                @default("ACTIVE")
  metadata    Json?
  locationId  Int
  createdById Int?
  createdAt   DateTime              @default(now())
  deletedBy   DeletedNotification[]
  createdBy   User?                 @relation(fields: [createdById], references: [id])
  location    Location              @relation(fields: [locationId], references: [id])

  @@index([locationId])
  @@index([type])
  @@index([entityType, entityId])
}

model Broadcast {
  id          Int          @id @default(autoincrement())
  title       String
  message     String
  image       String?
  scope       LocationType
  locationId  Int
  createdById Int
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   User         @relation(fields: [createdById], references: [id])
  location    Location     @relation(fields: [locationId], references: [id])

  @@index([locationId])
  @@index([createdById])
  @@index([scope])
}

model Community {
  id                  Int                @id @default(autoincrement())
  role                UserRole?
  locationId          Int?
  name                String             @unique
  description         String?
  image               String?
  allowMemberMessages Boolean            @default(true)
  isMuted             Boolean            @default(false)
  mutedUntil          DateTime?
  pinnedMessageId     Int?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  location            Location?          @relation(fields: [locationId], references: [id])
  members             CommunityMember[]
  messages            CommunityMessage[]
  posts               CommunityPost[]
  polls               Poll[]
}

model CommunityPost {
  id          Int                   @id @default(autoincrement())
  title       String
  content     String
  category    String?               @default("Information")
  images      String[]
  communityId Int
  createdById Int?
  likes       Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  status      String                @default("ACTIVE")
  memberId    Int?
  comments    CommunityComment[]
  community   Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy   User?                 @relation(fields: [createdById], references: [id])
  member      Member?               @relation(fields: [memberId], references: [id])
  likesList   CommunityPostLike[]
  reports     CommunityPostReport[]
}

model CommunityMember {
  id          Int       @id @default(autoincrement())
  communityId Int
  memberId    Int
  isMuted     Boolean   @default(false)
  mutedUntil  DateTime?
  unreadCount Int       @default(0)
  lastReadAt  DateTime?
  createdAt   DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([communityId, memberId])
}

model CommunityComment {
  id         Int           @id @default(autoincrement())
  content    String
  authorName String
  authorRole String?
  postId     Int
  createdAt  DateTime      @default(now())
  post       CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model CommunityMessage {
  id               Int                        @id @default(autoincrement())
  communityId      Int
  senderId         Int
  senderType       String
  message          String
  messageType      String                     @default("TEXT")
  mediaUrl         String?
  mediaType        String?
  fileName         String?
  metadata         Json?
  status           String                     @default("SENT")
  replyToMessageId Int?
  editedAt         DateTime?
  isDeleted        Boolean                    @default(false)
  deletedAt        DateTime?
  createdAt        DateTime                   @default(now())
  community        Community                  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  replyTo          CommunityMessage?          @relation("CommunityMessageReplies", fields: [replyToMessageId], references: [id])
  replies          CommunityMessage[]         @relation("CommunityMessageReplies")
  reactions        CommunityMessageReaction[]
  reads            CommunityMessageRead[]

  @@index([communityId, createdAt])
  @@index([senderId, senderType])
}

model CommunityMessageReaction {
  id          Int              @id @default(autoincrement())
  messageId   Int
  reactorId   Int
  reactorType String
  emoji       String
  createdAt   DateTime         @default(now())
  message     CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, reactorId, reactorType])
  @@index([messageId])
}

model CommunityMessageRead {
  id         Int              @id @default(autoincrement())
  messageId  Int
  readerId   Int
  readerType String
  readAt     DateTime         @default(now())
  message    CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, readerId, readerType])
  @@index([messageId])
}

model ContributionPlan {
  id               Int                    @id @default(autoincrement())
  name             String
  description      String?
  monthlyAmount    Float
  startDate        DateTime
  isActive         Boolean                @default(true)
  autoRenewEnabled Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  enrollments      MemberPlanEnrollment[]

  @@index([isActive])
}

model MemberPlanEnrollment {
  id        Int                   @id @default(autoincrement())
  memberId  Int
  planId    Int
  joinedAt  DateTime              @default(now())
  autoRenew Boolean               @default(true)
  status    EnrollmentStatus      @default(ACTIVE)
  updatedAt DateTime              @updatedAt
  payments  ContributionPayment[]
  member    Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan      ContributionPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([memberId, planId])
  @@index([memberId])
  @@index([planId])
  @@index([status])
}

model ContributionPayment {
  id            Int                   @id @default(autoincrement())
  enrollmentId  Int?
  memberId      Int
  amount        Float
  month         Int
  year          Int
  status        PaymentStatus         @default(PENDING)
  orderId       String?               @unique
  transactionId String?               @unique
  paymentMethod String?
  paidAt        DateTime?
  receiptNumber String?               @unique
  receiptUrl    String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  enrollment    MemberPlanEnrollment? @relation(fields: [enrollmentId], references: [id])
  member        Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, month, year])
  @@index([memberId])
  @@index([status])
  @@index([month, year])
}

model ContributionProfile {
  id                Int               @id @default(autoincrement())
  memberId          Int               @unique
  totalPaidMonths   Int               @default(0)
  currentStreak     Int               @default(0)
  totalContribution Float             @default(0)
  badge             ContributionBadge @default(BRONZE)
  contributionRank  Int?
  updatedAt         DateTime          @updatedAt
  member            Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([badge])
  @@index([totalContribution(sort: Desc)])
}

model PostLike {
  id        Int      @id @default(autoincrement())
  postId    Int
  memberId  Int
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, memberId])
}

model CommunityPostLike {
  id        Int           @id @default(autoincrement())
  postId    Int
  memberId  Int
  createdAt DateTime      @default(now())
  member    Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, memberId])
}

model PostReport {
  id           Int          @id @default(autoincrement())
  postId       Int
  reportedById Int
  reason       String
  status       ReportStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  post         Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  reportedBy   Member       @relation(fields: [reportedById], references: [id], onDelete: Cascade)

  @@unique([postId, reportedById])
  @@index([postId])
  @@index([reportedById])
}

model CommunityPostReport {
  id           Int           @id @default(autoincrement())
  postId       Int
  reportedById Int
  reason       String
  status       ReportStatus  @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  post         CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reportedBy   Member        @relation(fields: [reportedById], references: [id], onDelete: Cascade)

  @@unique([postId, reportedById])
  @@index([postId])
  @@index([reportedById])
}

model UserWarning {
  id              Int      @id @default(autoincrement())
  memberId        Int
  adminId         Int
  message         String
  postId          Int?
  communityPostId Int?
  pollId          Int?
  createdAt       DateTime @default(now())
  admin           User     @relation("AdminWarnings", fields: [adminId], references: [id], onDelete: Cascade)
  member          Member   @relation("MemberWarnings", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([adminId])
}

model PollLike {
  id        Int      @id @default(autoincrement())
  pollId    Int
  memberId  Int
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, memberId])
}

model PollComment {
  id         Int               @id @default(autoincrement())
  content    String
  authorName String
  authorRole String?
  pollId     Int
  parentId   Int?
  createdAt  DateTime          @default(now())
  poll       Poll              @relation(fields: [pollId], references: [id], onDelete: Cascade)
  parent     PollComment?      @relation("PollCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    PollComment[]     @relation("PollCommentReplies")
  likesList  PollCommentLike[]
}

model PollCommentLike {
  id            Int         @id @default(autoincrement())
  pollCommentId Int
  memberId      Int
  createdAt     DateTime    @default(now())
  pollComment   PollComment @relation(fields: [pollCommentId], references: [id], onDelete: Cascade)
  member        Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([pollCommentId, memberId])
}

model PollReport {
  id           Int          @id @default(autoincrement())
  pollId       Int
  reportedById Int
  reason       String
  status       ReportStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  poll         Poll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  reportedBy   Member       @relation(fields: [reportedById], references: [id], onDelete: Cascade)

  @@unique([pollId, reportedById])
  @@index([pollId])
  @@index([reportedById])
}

model DeletedNotification {
  id             Int          @id @default(autoincrement())
  notificationId Int
  userId         Int?
  memberId       Int?
  createdAt      DateTime     @default(now())
  member         Member?      @relation("MemberDeletedNotifications", fields: [memberId], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User?        @relation("UserDeletedNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@unique([notificationId, memberId])
  @@index([notificationId])
  @@index([userId])
  @@index([memberId])
}

enum LocationType {
  STATE
  DISTRICT
  TALUK
  AREA
  STREET
}

enum EventStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RequestType {
  EMERGENCY
  NORMAL
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CREATED
  PENDING_SUB_ADMIN
  APPROVED_SUB_ADMIN
  PENDING_ADMIN
  APPROVED_ADMIN
  PENDING_SUPER_ADMIN
  APPROVED_STATE
  REJECTED
}

enum RSVPStatus {
  GOING
  MAYBE
  NOT_GOING
  COMING
  ON_THE_WAY
  REACHED
  UNABLE
  CONTACT_REQUESTED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUB_ADMIN
  MEMBER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CampaignStatus {
  DRAFT
  SENT
  FAILED
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
}

enum ContributionBadge {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum ReminderNotificationType {
  PUSH
  SMS
  WHATSAPP
}

enum ReportStatus {
  PENDING
  IGNORED
  WARNED
  DELETED
}
