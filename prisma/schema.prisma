// Added after existing enums

enum ResponseStatus {
  INTERESTED
  MAYBE
  NOT_INTERESTED
  ATTENDING
  MAYBE_ATTENDING
  NOT_ATTENDING
}

model Response {
  id            Int            @id @default(autoincrement())
  messageId     Int            // References EmergencyRequest.id (or future EmergencyMessage.id)
  memberId      Int
  responseStatus ResponseStatus
  remarks       String?
  responseTime  DateTime       @default(now())
  createdAt     DateTime       @default(now())

  // Relations (optional)
  member        Member         @relation(fields: [memberId], references: [id])
  // Assuming emergency request as the message
  emergencyRequest EmergencyRequest @relation(fields: [messageId], references: [id])
}
