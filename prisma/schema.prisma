generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Location {
  id        Int              @id @default(autoincrement())
  name      String
  type      LocationType
  parentId  Int?
  password  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  targets   CampaignTarget[]
  parent    Location?        @relation("LocationHierarchy", fields: [parentId], references: [id])
  children  Location[]       @relation("LocationHierarchy")
  members   Member[]
  users     User[]
  events    Event[]
  requests  EmergencyRequest[]
  posts     Post[]
  notifications Notification[]

  @@index([parentId])
  @@index([type])
}

model Member {
  id           Int        @id @default(autoincrement())
  name         String
  phone        String     @unique
  password     String?
  bloodGroup            String?
  allergies             String?
  conditions            String?
  emergencyContact      String?
  role                  String    @default("Member")
  professionId          Int?
  profession            Profession? @relation(fields: [professionId], references: [id])
  locationId     Int
  location       Location   @relation(fields: [locationId], references: [id])
  approvalStatus ApprovalStatus @default(PENDING)
  consent        Boolean    @default(true)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  createdById    Int?
  createdBy      User?      @relation("MemberCreator", fields: [createdById], references: [id])
  approvedById   Int?
  approvedBy     User?      @relation("MemberApprover", fields: [approvedById], references: [id])
  messageLogs MessageLog[]
  requests    EmergencyRequest[]
  eventResponses EventResponse[]

  @@index([locationId])
  @@index([professionId])
}

model Profession {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  members   Member[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id              Int            @id @default(autoincrement())
  name            String
  phone           String         @unique
  password        String
  role            UserRole       @default(MEMBER)
  approvalStatus  ApprovalStatus @default(PENDING)
  locationId      Int?
  parentId        Int?
  parent          User?          @relation("Hierarchy", fields: [parentId], references: [id])
  children        User[]         @relation("Hierarchy")
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  auditLogs       AuditLog[]
  campaigns       Campaign[]
  createdEvents   Event[]
  createdRequests EmergencyRequest[]
  createdMembers  Member[]       @relation("MemberCreator")
  approvedMembers Member[]       @relation("MemberApprover")
  location        Location?      @relation(fields: [locationId], references: [id])

  @@index([role])
  @@index([approvalStatus])
}

model Campaign {
  id          Int              @id @default(autoincrement())
  title       String
  message     String
  createdById Int
  status      CampaignStatus   @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   User             @relation(fields: [createdById], references: [id])
  targets     CampaignTarget[]
  messageLogs MessageLog[]
}

model CampaignTarget {
  id         Int      @id @default(autoincrement())
  campaignId Int
  locationId Int
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  location   Location @relation(fields: [locationId], references: [id])
}

model MessageLog {
  id                Int           @id @default(autoincrement())
  campaignId        Int
  memberId          Int
  phone             String
  status            MessageStatus @default(PENDING)
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime      @default(now())
  campaign          Campaign      @relation(fields: [campaignId], references: [id])
  member            Member        @relation(fields: [memberId], references: [id])
}

model OTP {
  id         Int      @id @default(autoincrement())
  phone      String
  otp        String
  expiresAt  DateTime
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([phone])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  details   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Event {
  id          Int             @id @default(autoincrement())
  title       String
  description String?
  date        DateTime
  locationId  Int
  location    Location        @relation(fields: [locationId], references: [id])
  status      EventStatus     @default(ACTIVE)
  createdById Int
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  responses   EventResponse[]
}

model EventResponse {
  id        Int          @id @default(autoincrement())
  eventId   Int
  event     Event        @relation(fields: [eventId], references: [id])
  memberId  Int
  member    Member       @relation(fields: [memberId], references: [id])
  status    RSVPStatus
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([eventId, memberId])
}

model EmergencyRequest {
  id          Int           @id @default(autoincrement())
  title       String
  description String?
  type        RequestType   @default(EMERGENCY)
  status      RequestStatus @default(PENDING)
  locationId  Int
  location    Location      @relation(fields: [locationId], references: [id])
  memberId    Int?
  member      Member?       @relation(fields: [memberId], references: [id])
  createdById Int?
  createdBy   User?         @relation(fields: [createdById], references: [id])
  audience    String? // Ex: "ALL_CAPTAINS", "STREET_MEMBERS"
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Post {
  id         Int      @id @default(autoincrement())
  content    String
  image      String?
  authorName String
  authorRole String?
  likes      Int      @default(0)
  locationId Int
  location   Location @relation(fields: [locationId], references: [id])
  createdAt  DateTime @default(now())
}

model Notification {
  id         Int      @id @default(autoincrement())
  title      String
  message    String
  type       String   // "EVENT", "REQUEST", "ALERT"
  time       String?  // e.g. "2h ago"
  locationId Int
  location   Location @relation(fields: [locationId], references: [id])
  createdAt  DateTime @default(now())
}

enum LocationType {
  STATE
  DISTRICT
  TALUK
  AREA
  STREET
}

enum EventStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RequestType {
  EMERGENCY
  NORMAL
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum RSVPStatus {
  GOING
  MAYBE
  NOT_GOING
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUB_ADMIN
  MEMBER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CampaignStatus {
  DRAFT
  SENT
  FAILED
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}
